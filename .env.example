# AI造梦机 业务配置模板。复制为 .env 后填写，不得填写真实密钥后提交。

# 模型网关：AIHubMix（https://console.aihubmix.com/token 获取）
# 一个 Key 调通：文本(qwen) / 图片(qwen-image) / 视频(wan)
AIHUBMIX_API_KEY=

# 模型名（可选覆盖，默认值已内置，一般不用改）
LLM_MODEL=qwen3.5-plus
# 普通用户可选模型：只公开与本项目已支持协议兼容的 ID；留空禁用该类别。
PUBLIC_TEXT_MODELS=qwen3.5-plus,qwen3.5-flash
PUBLIC_IMAGE_MODELS=qwen-image-2.0,qwen-image-2.0-pro
PUBLIC_VIDEO_FIRST_FRAME_MODELS=wan2.7-i2v,wan2.6-i2v,doubao-seedance-2-5-260628,veo-3.1-generate-preview
PUBLIC_VIDEO_START_END_MODELS=wan2.7-i2v,doubao-seedance-2-5-260628,veo-3.1-generate-preview
PUBLIC_VIDEO_REFERENCE_MODELS=wan2.7-r2v,doubao-seedance-2-5-260628,veo-3.1-generate-preview
PUBLIC_VIDEO_SPEECH_MODELS=wan2.6-i2v
IMAGE_T2I_MODEL=qwen-image-2.0
VIDEO_FIRST_FRAME_MODEL=wan2.7-i2v
VIDEO_REFERENCE_MODEL=wan2.7-r2v
VIDEO_SPEECH_MODEL=wan2.6-i2v

# 管理员账号 user_id 白名单，逗号分隔；默认空，首次注册不会自动获得权限。
# 配置后重启后端生效，控制设置、系统沙盒和平台用量汇总，业务账号隔离不变。
ADMIN_USER_IDS=

# 生成并发保护：平台最多 2 个、每账号最多 1 个；保存、选版和阶段确认不占生成额度。
# 同一作品仍不能在生成期间同时编辑；超限返回 429，可等待后重试。
MAX_ACTIVE_EXECUTIONS=2
MAX_ACTIVE_EXECUTIONS_PER_USER=1

# 每月人民币估算预算（默认保护值，可调整）。月份按 Asia/Shanghai 的提交月份计算。
# 预留 + 按价格表计算的已完成费用共同占用预算；未知提交结果保留预留，不自动退款。
# 这些是平台生成限额，不是供应商账单；没有供应商金额时，实付字段为 null。
MONTHLY_BUDGET_CNY=500
MONTHLY_USER_BUDGET_CNY=100

# 默认读取 backend/model-cost-rates.json（含官方来源、日期和预算换算口径）。
# 可用下列 JSON 覆盖整个价格表；不要填空值，空值/缺模型/缺规格会阻止对应付费调用。
# 模型价格调整后应重新核对来源与币种。此处不填真实密钥，也不编写零价兜底。
# MODEL_COST_RATES_JSON={"model-id":{"kind":"image","image_cny":1,"currency":"CNY","source":"已核对的官方价格链接","as_of":"YYYY-MM-DD"}}

# 文本请求实际限制最大输出 token；预留据输入估算与该上限计算，返回 usage 后结算估算额。
LLM_MAX_OUTPUT_TOKENS=4096
# 安全审核使用最长边 1024px 的副本；输入值用于保守预算估算，输出上限实际传给模型。
VLM_MAX_INPUT_TOKENS=32768
VLM_MAX_OUTPUT_TOKENS=512

# 创作知识库：答案充分性判定（拒答）。默认开启；判定失败按资料未覆盖降级。
KNOWLEDGE_ADEQUACY_ENABLED=1
# 充分性判定的 JSON 解析重试次数（不含首次），控制评测与线上费用。
KNOWLEDGE_ADEQUACY_MAX_RETRIES=1
# 混合检索（BM25+向量 RRF）。默认关闭；仅在拒答能兜住跨域无答案后再开。
KNOWLEDGE_HYBRID_RETRIEVAL_ENABLED=0
KNOWLEDGE_HYBRID_CANDIDATE_N=20
KNOWLEDGE_HYBRID_RRF_K=60
