# AI造梦机 业务配置模板。复制为 .env 后填写，不得填写真实密钥后提交。

# 模型网关：AIHubMix（https://console.aihubmix.com/token 获取）
# 一个 Key 调通：文本(qwen) / 图片(qwen-image) / 视频(wan)
AIHUBMIX_API_KEY=

# 模型名（可选覆盖，默认值已内置，一般不用改）
LLM_MODEL=qwen3.5-plus
IMAGE_T2I_MODEL=qwen-image-2.0
VIDEO_FIRST_FRAME_MODEL=wan2.7-i2v
VIDEO_REFERENCE_MODEL=wan2.7-r2v
